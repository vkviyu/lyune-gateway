{
  "runtime": {
    "threads": 1
  },
  "server": {
    "listen_host": "127.0.0.1",
    "listen_port": 8443,
    "certificate_file": "server.crt",
    "private_key_file": "server.key",
    "wss": {
      "enabled": true,
      "listen_host": "127.0.0.1",
      "listen_port": 8444,
      "allowed_origins": ["http://127.0.0.1:5173", "http://localhost:5173"],
      "allow_missing_origin": false,
      "max_connections_per_worker": 64,
      "max_queued_bytes": 262144,
      "max_queued_records": 64,
      "tls_bio_capacity": 65536,
      "handshake_timeout_ms": 5000
    },
    "quic": {
      "max_connections": 1024,
      "idle_timeout_ms": 120000,
      "alpn": "lyune/2",
      "congestion_control": "bbr",
      "max_datagram_frame_size": 1200
    }
  },
  "backend": {
    "direct": {
      "routes": [
        {
          "group": 1,
          "route_key": 0,
          "endpoints": [{ "host": "127.0.0.1", "port": 9443 }]
        },
        {
          "group": 1,
          "route_key": 1,
          "endpoints": [{ "host": "127.0.0.1", "port": 9443 }]
        },
        {
          "group": 1,
          "route_key": 2,
          "endpoints": [{ "host": "127.0.0.1", "port": 9443 }]
        },
        {
          "group": 1,
          "route_key": 3,
          "endpoints": [{ "host": "127.0.0.1", "port": 9443 }]
        }
      ],
      "verify_certificate": false,
      "root_certificate_file": null,
      "client_certificate_file": null,
      "client_private_key_file": null,
      "max_receive_queue": 1024,
      "idle_timeout_ms": 120000,
      "alpn": "lyune/2",
      "congestion_control": "bbr"
    }
  },
  "worker": {
    "backend_poll_interval_ms": 10
  },
  "auth": {
    "required": true,
    "group": 1,
    "route_key": 1,
    "lifecycle": {
      "group": 1,
      "route_key": 3
    }
  },
  "cluster": {
    "enabled": false,
    "node_id": 1,
    "advertise_host": "127.0.0.1",
    "advertise_port": 7946,
    "forward_port": 7947,
    "deployment_mode": "direct",
    "return_path_capacity": 4096,
    "handoff_queue_capacity": 1024,
    "message_queue_capacity": 16,
    "placement": "affinity",
    "peer_port": 7948,
    "peer_cert_file": "",
    "peer_key_file": "",
    "peer_ca_file": "",
    "secret": "",
    "previous_secret": "",
    "max_nodes": 1024,
    "seeds": []
  }
}
